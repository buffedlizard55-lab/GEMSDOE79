+"""v4 (session 0bd0e0b2, IR-79-68): halo coverage at or above this is non-discriminating."""
+
+
+def chance_corrected(overlap, coverage):
+    """Cohen-kappa-style agreement beyond chance: (O - C) / (1 - C).
+
+    ``coverage`` C is the fraction of the candidate's allowed cells that lie within
+    3 px of the registry raster's dots, i.e. the expected forward overlap of a
+    uniform-random dot set. For C -> 0 the value equals the raw overlap, so the
+    inherited rule is unchanged for sparse dot fields. Returns None when C >= 1
+    (every possible map overlaps 100 %, so the test carries no information).
+    """
+    o, c = float(overlap), float(coverage)
+    if c >= CHANCE_INFORMATIVE_MAX:
+        return None
+    return (o - c) / (1.0 - c)
 
 
